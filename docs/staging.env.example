# Isolated Atlas runtime. Bind actual values from the approved secret store.
NODE_ENV=production
ATLAS_ENVIRONMENT=staging
ATLAS_STAGING_DATABASE=atlas_staging
ATLAS_DATABASE_URL=
ATLAS_SUPABASE_URL=
ATLAS_SUPABASE_ANON_KEY=
# Optional exact immediate peer. Requires exclusive private network path and header overwrite.
ATLAS_TRUSTED_PROXY_IP=
