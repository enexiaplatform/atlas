              "domain": {
                "default": "",
                "type": "string",
                "maxLength": 240
              },
              "asset_type": {
                "default": "",
                "type": "string",
                "maxLength": 240
              },
              "tag": {
                "default": "",
                "type": "string",
                "maxLength": 60
              },
              "collection": {
                "default": "",
                "type": "string",
                "maxLength": 240
              },
              "status": {
                "default": "",
                "type": "string",
                "maxLength": 60
              },
              "verification_status": {
                "default": "",
                "type": "string",
                "maxLength": 60
              },
              "sort": {
                "default": "updated",
                "type": "string",
                "enum": [
                  "updated",
                  "title"
                ]
              },
              "page": {
                "default": 1,
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              }
            },
            "additionalProperties": false
