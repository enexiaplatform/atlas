        "required": [
          "related_id",
          "relation"
        ],
        "additionalProperties": false
      },
      "ExternalReference": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "application": {
            "type": "string",
            "enum": [
