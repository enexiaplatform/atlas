{
  "openapi": "3.1.0",
  "info": {
    "title": "Enexia Atlas integration API",
    "version": "1.0.0"
  },
  "security": [
    {
      "bearer": []
    },
    {
      "session": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      },
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "atlas_session"
      }
    },
    "schemas": {
      "AssetInput": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "asset_type": {
            "type": "string",
            "enum": [
              "Research Report",
              "Market Landscape",
              "Market Sizing",
              "Customer / Institution Profile",
              "Competitor Profile",
              "Product Profile",
              "Product Comparison",
              "Pricing Intelligence",
              "Scientific Application",
              "Technical Workflow",
              "Business Strategy",
              "Go-To-Market Plan",
              "SOP / Playbook",
              "Decision Record",
              "Lessons Learned"
            ]
          },
          "domain": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "description": {
            "default": "",
            "type": "string",
            "maxLength": 14000
          },
          "structured_content": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            "additionalProperties": {
              "type": "string",
              "maxLength": 4000
            }
          },
          "collection": {
            "default": "General",
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "tags": {
            "default": [],
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            }
          },
          "classification": {
            "default": "Workspace",
            "type": "string",
            "enum": [
              "Workspace",
              "Shareable"
            ]
          },
          "next_review_at": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "title",
          "asset_type",
          "domain"
        ],
        "additionalProperties": false
      },
      "Review": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "lifecycle_status": {
            "type": "string",
            "enum": [
              "Draft",
              "In Review",
              "Published",
              "Superseded",
              "Archived"
            ]
          },
          "verification_status": {
            "type": "string",
            "enum": [
              "Unverified",
              "Partially Verified",
              "Verified",
              "Disputed"
            ]
          }
        },
        "required": [
          "lifecycle_status",
          "verification_status"
        ],
        "additionalProperties": false
      },
      "Evidence": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "attachment_id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "passage": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          },
          "claim": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "kind": {
            "type": "string",
            "enum": [
              "Fact",
              "Estimate",
              "Hypothesis"
            ]
          }
        },
        "required": [
          "source",
          "passage",
          "claim",
          "kind"
        ],
        "additionalProperties": false
      },
      "Relationship": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "related_id": {
            "type": "string",
