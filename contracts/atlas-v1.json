  "paths": {
    "/api/v1/workspaces/{workspace}/assets": {
      "get": {
        "operationId": "queryKnowledge",
        "description": "Permission-filtered search with 25 records per page.",
        "parameters": [
          {
            "name": "workspace",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "default": "",
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "name": "domain",
            "in": "query",
            "schema": {
              "default": "",
              "type": "string",
              "maxLength": 240
            }
          },
          {
            "name": "asset_type",
            "in": "query",
            "schema": {
              "default": "",
              "type": "string",
              "maxLength": 240
            }
          },
          {
            "name": "tag",
            "in": "query",
            "schema": {
              "default": "",
              "type": "string",
              "maxLength": 60
            }
          },
          {
            "name": "collection",
            "in": "query",
            "schema": {
              "default": "",
              "type": "string",
              "maxLength": 240
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "default": "",
              "type": "string",
              "maxLength": 60
            }
          },
          {
            "name": "verification_status",
            "in": "query",
            "schema": {
              "default": "",
              "type": "string",
              "maxLength": 60
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "default": "updated",
              "type": "string",
              "enum": [
                "updated",
                "title"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "default": 1,
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authorized result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "items",
                    "total"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/AssetRecord"
                      }
                    },
                    "total": {
                      "type": "integer"
                    }
                  }
                }
              }
